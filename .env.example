# Copy this file to .env for running services outside Docker (e.g. local dev with
# a native node process). Docker Compose sets its own env variables directly in
# docker-compose.yml and does NOT read this .env file.

# PostgreSQL connection string.
# Inside Docker: the hostname is "postgres" (the service name).
# Outside Docker: the hostname is "localhost" (port 5432 is exposed on the host).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gridfault

# Port the backend Fastify server listens on.
PORT=3001

# (Phase 2+) OpenAI key for the AI briefing feature.
# Leave blank to disable — the system works without it.
# OPENAI_API_KEY=sk-...
