# ==============================================================================
# ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to `.env` in the root directory for local dev or custom deployments.
# Docker Compose sets safe defaults automatically inside docker-compose.yml.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Variable: DATABASE_URL
# Purpose : PostgreSQL connection string for Prisma ORM.
# Required: YES
# Default : postgresql://postgres:postgres@localhost:5432/gridfault (outside Docker)
#           postgresql://postgres:postgres@postgres:5432/gridfault  (inside Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gridfault

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Variable: PORT
# Purpose : Port that the Fastify HTTP backend server binds to.
# Required: YES
# Default : 3001
PORT=3001

# Variable: NODE_ENV
# Purpose : Application execution environment ('development' | 'production' | 'test').
# Required: NO
# Default : development
NODE_ENV=development

# ------------------------------------------------------------------------------
# 3. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
# Variable: VITE_BACKEND_URL
# Purpose : Public HTTP URL of the backend API called by the Vite React frontend.
# Required: NO (defaults to http://localhost:3001 if omitted)
# Default : http://localhost:3001
VITE_BACKEND_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 4. OPTIONAL AI FEATURE CONFIGURATION
# ------------------------------------------------------------------------------
# Variable: OPENAI_API_KEY
# Purpose : OpenAI API key for generating live plain-language AI briefing summaries.
# Required: NO (System automatically falls back to deterministic template summaries)
# Default : [BLANK]
# OPENAI_API_KEY=sk-proj-...
